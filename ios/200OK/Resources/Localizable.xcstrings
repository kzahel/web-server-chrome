    "The server stopped when 200 OK moved to the background. Start it again when you’re ready.": {
      "comment": "200 OK product copy: IOSServerController.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server se zastavil při přechodu aplikace 200 OK na pozadí. Až budete chtít pokračovat, znovu ho spusťte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-serveren stoppede, da 200 OK gik i baggrunden. Start den igen, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gestoppt, als 200 OK in den Hintergrund wechselte. Starte ihn erneut, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server stopped when 200 OK moved to the background. Start it again when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se detuvo cuando 200 OK pasó a segundo plano. Vuelva a iniciarlo cuando lo desee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur HTTP s’est arrêté lorsque 200 OK est passé en arrière-plan. Redémarrez-le lorsque vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server si è arrestato quando 200 OK è passato in background. Riavviarlo quando si desidera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De HTTP-server is gestopt omdat 200 OK naar de achtergrond ging. Start de server opnieuw wanneer je er klaar voor bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer HTTP został zatrzymany po przejściu aplikacji 200 OK do tła. Można go uruchomić ponownie w dogodnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

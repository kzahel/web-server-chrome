{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "comment": "System local-network permission explanation. iOS only serves while foregrounded.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK stellt den von dir ausgewählten Ordner für Geräte in deinem lokalen Netzwerk bereit, solange diese App im Vordergrund geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK serves the folder you choose to devices on your local network while this app is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK permite acceder a la carpeta que seleccione desde dispositivos de su red local mientras esta aplicación está en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK met le dossier de votre choix à la disposition des appareils de votre réseau local tant que l’application reste au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK rende disponibile la cartella selezionata ai dispositivi sulla rete locale mentre l’app è in primo piano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK maakt de map die je kiest toegankelijk voor apparaten op je lokale netwerk zolang deze app op de voorgrond staat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O 200 OK disponibiliza a pasta que você escolher para dispositivos na sua rede local enquanto este app estiver aberto em primeiro plano."
          }
        }
      }
    }
  },
  "version": "1.0"
}

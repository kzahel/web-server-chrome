    "No current Wi-Fi address is available. The server remains local to this iPhone until Wi-Fi is ready.": {
      "comment": "200 OK product copy: ServerScreen.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentálně není k dispozici adresa Wi-Fi. Dokud nebude Wi-Fi připravena, bude server dostupný pouze na tomto iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen tilgængelig Wi-Fi-adresse i øjeblikket. HTTP-serveren er kun tilgængelig på denne iPhone, indtil Wi-Fi er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit ist keine WLAN-Adresse verfügbar. Der Server bleibt nur auf diesem iPhone erreichbar, bis das WLAN bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No current Wi-Fi address is available. The server remains local to this iPhone until Wi-Fi is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna dirección Wi-Fi disponible en este momento. Solo se puede acceder al servidor desde este iPhone hasta que la conexión Wi-Fi esté lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune adresse Wi-Fi n’est disponible pour le moment. Le serveur HTTP reste accessible uniquement sur cet iPhone tant que le Wi-Fi n’est pas prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è disponibile alcun indirizzo Wi-Fi. Il server resta accessibile solo da questo iPhone finché il Wi-Fi non è pronto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is momenteel geen Wi-Fi-adres beschikbaar. De HTTP-server blijft alleen op deze iPhone bereikbaar totdat Wi-Fi beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aktualnego adresu Wi-Fi. Dopóki sieć Wi-Fi nie będzie gotowa, serwer HTTP jest dostępny tylko na tym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum endereço Wi-Fi está disponível no momento. O servidor HTTP permanece acessível apenas neste iPhone até que o Wi-Fi esteja pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentan nu este disponibilă nicio adresă Wi-Fi. Serverul rămâne accesibil doar pe acest iPhone până când conexiunea Wi-Fi este disponibilă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас адрес Wi-Fi недоступен. Пока Wi-Fi не будет готов к работе, HTTP-сервер доступен только на этом iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktuell Wi-Fi-adress är tillgänglig. HTTP-servern är bara åtkomlig på denna iPhone tills Wi-Fi är redo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі адреса Wi-Fi недоступна. HTTP-сервер залишатиметься доступним лише на цьому iPhone, доки з’єднання Wi-Fi не буде готове до роботи."
          }
        }
      }
    },

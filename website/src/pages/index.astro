---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const chromeWebStoreUrl =
  "https://chromewebstore.google.com/detail/web-server-for-chrome/lpkjdhnmgkhaabhimpdinmdgejoaejic";
const googlePlayUrl =
  "https://play.google.com/store/apps/details?id=app.ok200.android";
---

<BaseLayout
  title="200 OK Web Server — Successor to Web Server for Chrome"
  description="200 OK Web Server is the lightweight cross-platform successor to Web Server for Chrome, rebuilt by the original author for desktop, Android, and ChromeOS."
>
  <Header activePage="home" />

  <main>
    <section class="hero">
      <div class="container">
        <img src="/logo-256.png" alt="200 OK!" class="hero-logo">
        <h1>Serve files locally.<br>On the device you use.</h1>
        <div class="hero-badge">From the creator of Web Server for Chrome (200k+ users)</div>
        <p>200 OK Web Server carries the original Web Server for Chrome workflow forward across desktop, Android, and ChromeOS.</p>
        <div class="hero-actions">
          <a href="/download" class="hero-cta">Download for desktop</a>
          <a href="#platforms" class="hero-cta-secondary">See all platforms</a>
        </div>
        <p class="hero-cta-note">Free and open source. Signed builds for macOS, Windows, and Linux.</p>
        <div class="signup-form-wrapper" id="signup-section">
          <p class="signup-label">Or get release announcements by email</p>
          <form
            action="https://buttondown.com/api/emails/embed-subscribe/ok200"
            method="post"
            class="embeddable-buttondown-form signup-form"
          >
            <label for="bd-email" class="sr-only">Enter your email</label>
            <input
              type="email"
              name="email"
              id="bd-email"
              placeholder="you@example.com"
              required
              autocomplete="email"
            />
            <input type="submit" value="Subscribe" />
          </form>
          <p class="signup-note">
            <a href="https://buttondown.com/refer/ok200" target="_blank">
              Powered by Buttondown.
            </a>
          </p>
        </div>
      </div>
    </section>

    <section id="platforms" class="platforms">
      <div class="container">
        <h2>Choose the version for your device.</h2>
        <p class="section-subtitle">Choose a folder, start the server, and share its URL. Each supported platform has a focused native experience.</p>
        <div class="platform-grid">
          <a class="platform-card" href="/download">
            <div class="platform-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <h3>Desktop</h3>
            <p>A lightweight app for macOS, Windows, and Linux with native Rust serving.</p>
            <span class="platform-action">Download desktop <span aria-hidden="true">→</span></span>
          </a>
          <a class="platform-card" href={googlePlayUrl}>
            <div class="platform-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
            </div>
            <h3>Android</h3>
            <p>A native Android app with responsive controls and reliable background options.</p>
            <span class="platform-action">Get the Android app <span aria-hidden="true">→</span></span>
          </a>
          <a class="platform-card" href="/chromeos">
            <div class="platform-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" y1="8" x2="12" y2="8"/><line x1="3.95" y1="6.06" x2="8.54" y2="14"/><line x1="10.88" y1="21.94" x2="15.46" y2="14"/></svg>
            </div>
            <h3>ChromeOS</h3>
            <p>Choose the quick Android route or the no-Play Linux version with extension controls.</p>
            <span class="platform-action">Compare ChromeOS options <span aria-hidden="true">→</span></span>
          </a>
          <a class="platform-card" href={chromeWebStoreUrl}>
            <div class="platform-icon">
              <img src="/logo-128.png" alt="" class="platform-logo">
            </div>
            <h3>Chrome Extension</h3>
            <p>Launch the desktop app or set up and control the ChromeOS Linux server.</p>
            <span class="platform-action">Install the extension <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <section id="features" class="features">
      <div class="container">
        <h2>Features</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <h3>Static file serving</h3>
            <p>Serve any directory with automatic MIME type detection and index.html resolution.</p>
          </div>
          <div class="feature-card">
            <h3>Directory listing</h3>
            <p>Browse files with sizes and dates when no index.html exists.</p>
          </div>
          <div class="feature-card">
            <h3>SPA mode</h3>
            <p>Route all paths to index.html for single-page app development.</p>
          </div>
          <div class="feature-card">
            <h3>CORS headers</h3>
            <p>Enable cross-origin requests with one straightforward setting.</p>
          </div>
          <div class="feature-card">
            <h3>ETag caching</h3>
            <p>Automatic ETag generation and 304 Not Modified responses.</p>
          </div>
          <div class="feature-card">
            <h3>Range requests</h3>
            <p>Seek and stream large files without downloading them from the beginning.</p>
          </div>
        </div>

        <h3 class="coming-soon-heading">On the roadmap</h3>
        <div class="feature-grid">
          <div class="feature-card coming-soon">
            <h3>HTTPS</h3>
            <p>Self-signed certificate generation for local HTTPS development.</p>
          </div>
          <div class="feature-card coming-soon">
            <h3>HTTP Basic Auth</h3>
            <p>Protect access to served files with a username and password.</p>
          </div>
          <div class="feature-card coming-soon">
            <h3>QR code</h3>
            <p>Scan a QR code to access your server from a phone on the same LAN.</p>
          </div>
          <div class="feature-card coming-soon">
            <h3>Live reload</h3>
            <p>Automatically refresh the browser when files change.</p>
          </div>
          <div class="feature-card coming-soon">
            <h3>Reverse proxy</h3>
            <p>Proxy API requests to a backend server during development.</p>
          </div>
          <div class="feature-card coming-soon">
            <h3>Multiple servers</h3>
            <p>Run more than one independently configured server at a time.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="vs-competition">
      <div class="container">
        <h2>Why not Simple Web Server?</h2>
        <p class="section-subtitle">Simple Web Server is an Electron app built by third parties. We're the original author, building it right.</p>
        <div class="comparison">
          <table>
            <thead>
              <tr>
                <th></th>
                <th>200 OK Web Server</th>
                <th>Simple Web Server</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Original author</td><td class="yes">Yes</td><td class="no">No</td></tr>
              <tr><td>Install size</td><td class="yes">~10MB (Tauri)</td><td class="no">100MB+ (Electron)</td></tr>
              <tr><td>Android / ChromeOS</td><td class="yes">Yes</td><td class="no">No</td></tr>
              <tr><td>Open source</td><td class="yes">MIT</td><td class="yes">MIT</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="migration" class="migration">
      <div class="container">
        <h2>Migrating from the Chrome App?</h2>
        <div class="migration-content">
          <p>The original Web Server for Chrome was a Chrome App used by 200,000+ people. Google discontinued Chrome Apps, so its original author is carrying the familiar workflow forward as 200 OK Web Server.</p>
          <ul>
            <li>The Chrome extension launches the desktop app and controls the ChromeOS Linux version; it does not serve files itself.</li>
            <li>ChromeOS users can choose Android through Google Play or the Linux version on compatible devices. <a href="/chromeos">Compare ChromeOS options.</a></li>
            <li>Feature availability differs by platform. Feature parity is a direction, not a claim that every legacy option is already present.</li>
          </ul>
          <p>The original Chrome App source code is preserved in the <a href="https://github.com/kzahel/web-server-chrome/tree/legacy">legacy branch</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 80px 0 60px;
    text-align: center;
  }

  .hero-badge {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .hero-logo {
    width: 128px;
    height: 128px;
    margin-bottom: 24px;
  }

  .hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .hero p {
    font-size: 18px;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Platforms */
  .platforms {
    padding: 60px 0;
    border-top: 1px solid var(--border);
  }

  .platforms h2 {
    font-size: 28px;
    margin-bottom: 12px;
    text-align: center;
  }

  .section-subtitle {
    color: var(--text-secondary);
    text-align: center;
    max-width: 600px;
    margin: 0 auto 40px;
    font-size: 15px;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .platform-card {
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    padding: 24px;
    text-align: center;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, background-color 0.2s;
  }

  .platform-card:hover {
    background: var(--bg-tertiary);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .platform-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .platform-icon {
    color: var(--accent);
    margin-bottom: 12px;
  }

  .platform-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }

  .platform-card p {
    color: var(--text-secondary);
    flex: 1;
    font-size: 13px;
    margin-bottom: 18px;
    max-width: 270px;
  }

  .platform-logo {
    border-radius: 50%;
    display: block;
    height: 32px;
    width: 32px;
  }

  .platform-action {
    align-items: center;
    background: var(--accent);
    border-radius: 999px;
    color: #1a1a1a;
    display: inline-flex;
    font-size: 12px;
    font-weight: 700;
    gap: 6px;
    padding: 6px 12px;
  }

  /* Features */
  .features {
    padding: 60px 0;
    border-top: 1px solid var(--border);
  }

  .features h2 {
    font-size: 28px;
    margin-bottom: 40px;
    text-align: center;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .feature-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
  }

  .feature-card h3 {
    font-size: 15px;
    margin-bottom: 8px;
    color: var(--accent);
  }

  .feature-card p {
    color: var(--text-secondary);
    font-size: 13px;
  }

  .feature-card.coming-soon {
    opacity: 0.7;
    border-style: dashed;
  }

  .coming-soon-heading {
    text-align: center;
    margin: 40px 0 20px;
    color: var(--text-secondary);
    font-size: 18px;
  }

  /* Competition */
  .vs-competition {
    padding: 60px 0;
    border-top: 1px solid var(--border);
  }

  .vs-competition h2 {
    font-size: 28px;
    margin-bottom: 12px;
    text-align: center;
  }

  .comparison table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-top: 24px;
  }

  .comparison th,
  .comparison td {
    padding: 12px;
    text-align: left;
    border: 1px solid var(--border);
  }

  .comparison th {
    background: var(--bg-tertiary);
    font-weight: 600;
    color: var(--text-primary);
  }

  .comparison td {
    color: var(--text-secondary);
  }

  .comparison td.yes {
    color: var(--accent);
  }

  .comparison td.no {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  /* Migration */
  .migration {
    padding: 60px 0;
    border-top: 1px solid var(--border);
  }

  .migration h2 {
    font-size: 28px;
    margin-bottom: 24px;
    text-align: center;
  }

  .migration-content {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px;
  }

  .migration-content p {
    color: var(--text-secondary);
    font-size: 15px;
    margin-bottom: 16px;
  }

  .migration-content ul {
    color: var(--text-secondary);
    font-size: 15px;
    padding-left: 24px;
    margin-bottom: 16px;
  }

  .migration-content li {
    margin-bottom: 8px;
  }

  .migration-content a {
    color: var(--accent);
    text-decoration: none;
  }

  .migration-content a:hover {
    text-decoration: underline;
  }

  /* Hero call to action */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin: 32px 0 0;
  }

  .hero-cta {
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 8px;
    color: #1a1a1a;
    font-size: 16px;
    font-weight: 600;
    padding: 13px 28px;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .hero-cta:hover {
    background: var(--accent-hover);
  }

  .hero-cta-secondary {
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 500;
    padding: 13px 28px;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .hero-cta-secondary:hover {
    border-color: var(--text-secondary);
  }

  .hero .hero-cta-note {
    color: var(--text-secondary);
    font-size: 13px;
    margin: 14px 0 0;
  }

  /* Signup form */
  .signup-form-wrapper {
    max-width: 460px;
    margin: 40px auto 0;
  }

  .hero .signup-label {
    color: var(--text-secondary);
    font-size: 13px;
    margin: 0 0 10px;
  }

  .signup-form {
    display: flex;
    gap: 8px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .signup-form input[type="email"] {
    flex: 1;
    padding: 12px 16px;
    font-size: 15px;
    font-family: inherit;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .signup-form input[type="email"]::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .signup-form input[type="email"]:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(248, 210, 3, 0.15);
  }

  .signup-form input[type="submit"] {
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 500;
    font-family: inherit;
    background: var(--accent);
    color: #1a1a1a;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .signup-form input[type="submit"]:hover {
    background: var(--accent-hover);
  }

  .hero .signup-note {
    margin: 10px auto 0;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .signup-note a {
    color: inherit;
  }

  /* Mobile */
  @media (max-width: 600px) {
    .hero {
      padding: 48px 0 40px;
    }

    .signup-form {
      flex-direction: column;
    }

    .signup-form input[type="submit"] {
      width: 100%;
    }

    .platform-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

    "android": [
      {
        "id": "android-settings-oldest",
        "form": "oldest",
        "values": { "port": 9000 },
        "expected": {
          "port": 9000,
          "lanEnabled": true,
          "directoryListing": true,
          "corsEnabled": false,
          "spaEnabled": false,
          "lifetimeMode": "background",
          "wakeLockMode": "none",
          "shutdownBatteryThreshold": 15

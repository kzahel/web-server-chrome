{
  "manifest_version": 3,
  "name": "__MSG_app_name__",
  "short_name": "200 OK",
  "version": "0.1.10",
  "description": "__MSG_app_description__",
  "permissions": ["nativeMessaging"],
  "optional_host_permissions": ["http://penguin.linux.test/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/app.html",
    "default_title": "__MSG_action_title__"
  },
  "icons": {
    "16": "icons/ok-16.png",
    "32": "icons/ok-32.png",
    "48": "icons/ok-48.png",
    "128": "icons/ok-128.png"
  },
  "externally_connectable": {
    "ids": ["ofhbbkphhbklhfoeikjpcbhemlocgigb"],
    "matches": [
      "https://ok200.app/*",
      "http://local.ok200.app/*",
      "http://penguin.linux.test/*"
    ]
  },
  "default_locale": "en"
}

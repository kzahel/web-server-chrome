    "Choose a serving folder to enable the server.": {
      "comment": "200 OK product copy: ServerScreen.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li server spustit, vyberte složku, jejíž obsah bude poskytovat."
          }
        },
        "da": {
          "stringUnit": {

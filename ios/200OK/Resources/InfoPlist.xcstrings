{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "comment": "System local-network permission explanation. iOS only serves while foregrounded.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK stellt den von dir ausgewählten Ordner für Geräte in deinem lokalen Netzwerk bereit, solange diese App im Vordergrund geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK serves the folder you choose to devices on your local network while this app is open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK met le dossier de votre choix à la disposition des appareils de votre réseau local tant que l’application reste au premier plan."
          }
        }
      }
    }
  },
  "version": "1.0"
}

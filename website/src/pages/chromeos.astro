---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const playStoreUrl =
  "https://play.google.com/store/apps/details?id=app.ok200.android";
const chromeOsUrl = "https://ok200.app/chromeos";
const androidIntentUrl =
  "intent://launch#Intent;scheme=ok200;package=app.ok200.android;" +
  `S.browser_fallback_url=${encodeURIComponent(chromeOsUrl)};end`;
---

<BaseLayout
  title="200 OK Web Server on ChromeOS"
  description="Open or install the 200 OK Web Server Android app on supported Chromebooks, with clear alternatives when Android apps or Google Play are unavailable."
>
  <Header />

  <main class="chromeos-page">
    <section class="chromeos-hero">
      <div class="container narrow">
        <p class="eyebrow">ChromeOS</p>
        <h1>200 OK Web Server on your Chromebook</h1>
        <p class="lede">
          The Chrome extension is a launcher. Use the Android app when Google
          Play is available, or the lightweight Linux version when it is not.
        </p>
      </div>
    </section>

    <section class="chromeos-options">
      <div class="container narrow cards">
        <article class="option-card recommended">
          <p class="option-label">Recommended today</p>
          <h2>Use the Android app</h2>
          <p>
            This requires a Chromebook that supports Android apps, with Google
            Play enabled for the current account. Some older, managed, work, or
            school Chromebooks do not provide Google Play.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={androidIntentUrl} target="_blank" rel="noopener">Open Android app</a>
            <a class="btn btn-secondary" href={playStoreUrl}>View on Google Play</a>
          </div>
          <p class="note">
            ChromeOS may ask you to confirm which app should open. If 200 OK is
            not offered and Google Play is unavailable in ChromeOS Settings,
            this Android route is not available on this Chromebook.
          </p>
        </article>

        <article class="option-card">
          <p class="option-label">No Android or Google Play</p>
          <h2>Use the Linux version</h2>
          <p>
            The lightweight ChromeOS Linux component works with the extension
            and installs for your Linux user without sudo. It is available for
            x86_64 and ARM64 Chromebooks. Your Chromebook and profile must
            allow the Linux development environment.
          </p>
          <div class="actions">
            <a class="btn btn-secondary" href="/chromeos/linux">Linux setup guide</a>
          </div>
          <p class="note">
            Initial installation needs Internet access. Afterward, the
            Launcher and extension controller work locally and can be used
            offline.
          </p>
        </article>

        <article class="option-card">
          <p class="option-label">Another fallback</p>
          <h2>Use another supported device</h2>
          <p>
            Run 200 OK on a macOS, Windows, or Linux computer, or on another
            Android device, and open the displayed network URL from your
            Chromebook.
          </p>
          <div class="actions">
            <a class="btn btn-secondary" href="/download">Desktop downloads</a>
            <a class="text-link" href="/#platforms">All supported platforms</a>
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .chromeos-page {
    min-height: 70vh;
  }

  .narrow {
    max-width: 820px;
  }

  .chromeos-hero {
    padding: 72px 0 40px;
    text-align: center;
  }

  .eyebrow,
  .option-label {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0 16px;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.08;
  }

  .lede {
    margin: 0 auto;
    max-width: 650px;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .chromeos-options {
    padding: 0 0 80px;
  }

  .cards {
    display: grid;
    gap: 20px;
  }

  .option-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-secondary);
  }

  .option-card.recommended {
    border-color: var(--accent);
  }

  .option-card h2 {
    margin: 5px 0 10px;
  }

  .option-card p {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .note {
    margin: 18px 0 0;
    font-size: 0.9rem;
  }

  .text-link {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .chromeos-hero {
      padding-top: 48px;
    }

    .option-card {
      padding: 22px;
    }

    .actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>

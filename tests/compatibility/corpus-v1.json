      },
      {
        "id": "android-settings-unknown-future",
        "form": "unknown-future",
        "values": { "port": 8082, "future_mode": "safe" },
        "expected": {
          "port": 8082,
          "lanEnabled": true,
          "directoryListing": true,
          "corsEnabled": false,
          "spaEnabled": false,
          "lifetimeMode": "background",
          "wakeLockMode": "none",
          "shutdownBatteryThreshold": 15

    "Serve the root index.html for missing routes without extensions.": {
      "comment": "200 OK product copy: ServerScreen.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro neexistující cesty bez přípony poskytovat index.html z kořenové složky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Levér index.html fra rodmappen, når en rute uden filendelse ikke findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle bei fehlenden Routen ohne Dateiendung die index.html aus dem Stammordner bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve the root index.html for missing routes without extensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servir el archivo index.html de la carpeta raíz para las rutas sin extensión que no existan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoyer le fichier index.html du dossier racine pour les routes introuvables sans extension."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornire il file index.html della cartella radice per i percorsi non trovati senza estensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張子のないルートが見つからない場合は、ルートフォルダーの index.html を配信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장자가 없는 경로가 존재하지 않으면 루트 폴더의 index.html을 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bied index.html uit de hoofdmap aan voor ontbrekende routes zonder bestandsextensie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnia plik index.html z folderu głównego dla nieistniejących ścieżek bez rozszerzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {

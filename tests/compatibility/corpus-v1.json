  "historicalIncompatibilities": [
    {
      "id": "crostini-protocol-1-to-2-rollout",
      "affectedPublicVersions": [
        "extension-v0.1.7",
        "extension-v0.1.8",
        "crostini-v0.1.0",
        "crostini-v0.1.1"
      ],
      "reason": "The signed controller bootstrap moved to protocol 2 before Chrome Web Store delivery of extension 0.1.8.",
      "recovery": "Update both the Chrome extension and Linux component; the controller UI exposes Linux setup and rollback recovery.",
      "removalPoint": "Retain permanently as rollout-history regression evidence; do not advertise protocol 1 support."
    }
  ]
}

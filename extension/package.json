{
  "name": "@ok200/extension",
  "version": "0.1.8",
  "description": "200 OK Web Server Chrome Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:extension dev:web",
    "dev:extension": "vite build --watch",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

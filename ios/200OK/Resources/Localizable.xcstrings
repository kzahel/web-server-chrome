    "The server stopped when 200 OK moved to the background. Start it again when you’re ready.": {
      "comment": "200 OK product copy: IOSServerController.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server se zastavil při přechodu aplikace 200 OK na pozadí. Až budete chtít pokračovat, znovu ho spusťte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-serveren stoppede, da 200 OK gik i baggrunden. Start den igen, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gestoppt, als 200 OK in den Hintergrund wechselte. Starte ihn erneut, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server stopped when 200 OK moved to the background. Start it again when you’re ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se detuvo cuando 200 OK pasó a segundo plano. Vuelva a iniciarlo cuando lo desee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur HTTP s’est arrêté lorsque 200 OK est passé en arrière-plan. Redémarrez-le lorsque vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server si è arrestato quando 200 OK è passato in background. Riavviarlo quando si desidera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK がバックグラウンドに移ったため、HTTP サーバーを停止しました。準備ができたら、もう一度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK가 백그라운드로 전환되어 HTTP 서버가 중지되었습니다. 준비되면 다시 시작하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De HTTP-server is gestopt omdat 200 OK naar de achtergrond ging. Start de server opnieuw wanneer je er klaar voor bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer HTTP został zatrzymany po przejściu aplikacji 200 OK do tła. Można go uruchomić ponownie w dogodnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor HTTP parou quando o 200 OK passou para segundo plano. Inicie o servidor novamente quando quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul s-a oprit când 200 OK a trecut în fundal. Îl puteți reporni când doriți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-сервер остановлен, поскольку 200 OK перешло в фоновый режим. Запустите сервер снова, когда будете готовы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-servern stoppades när 200 OK gick till bakgrunden. Starta den igen när du är redo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK arka plana geçtiğinde HTTP sunucusu durduruldu. Hazır olduğunuzda yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-сервер зупинився, коли 200 OK перейшов у фоновий режим. Запустіть його знову, коли будете готові."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK 进入后台时，HTTP 服务器已停止。准备就绪后可重新启动。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK 進入背景時，HTTP 伺服器已停止。準備就緒後，請重新啟動伺服器。"
          }
        }
      }
    },

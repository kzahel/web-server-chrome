    "Choose a folder before starting the server.": {
      "comment": "200 OK product copy: Storage/SecurityScopedRoot.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před spuštěním serveru vyberte složku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe, før du starter HTTP-serveren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner aus, bevor du den Server startest."
          }
        },
        "en": {

{
  "private": true,
  "license": "MIT",
  "homepage": "https://ok200.app/",
  "repository": "github:kzahel/web-server-chrome",
  "bugs": "https://ok200.app/feedback",
  "workspaces": [
    "packages/*",
    "desktop/tauri-app",
    "extension",
    "website"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "desktop:dev": "pnpm --filter @ok200/desktop tauri dev",
    "desktop:build": "pnpm --filter @ok200/desktop tauri build",
    "ext:dev": "pnpm --filter @ok200/extension dev",
    "ext:build": "pnpm --filter @ok200/extension build",
    "i18n:status": "python3 scripts/localization.py status",
    "i18n:check": "node scripts/check-localization.mjs && python3 -m unittest discover -s scripts -p \"test_*localization*.py\"",
    "i18n:generate": "node scripts/generate-localization.mjs"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "overrides": {
      "tsx": "^4.23.15"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@playwright/test": "1.64.1",
    "intl-messageformat": "11.2.9",
    "typescript": "7.0.2"
  }
}

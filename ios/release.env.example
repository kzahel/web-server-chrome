# Copy to ios/release.local.env, which is ignored, or export these variables.
# These are account identifiers and local paths, not application source.
IOS_TEAM_ID=
IOS_PROVISIONING_PROFILE_SPECIFIER=

# Required only by release-archive.sh --signed --validate.
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=

# Optional output/configuration overrides.
# IOS_RELEASE_OUTPUT_DIR=

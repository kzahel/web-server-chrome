    "Serving works while 200 OK is open. iOS stops the server when the app moves to the background.": {
      "comment": "200 OK product copy: ServerScreen.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskytování souborů funguje, jen když je 200 OK v popředí. iOS zastaví server při přechodu aplikace na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-serveren kører, mens 200 OK er åben. iOS stopper serveren, når appen går i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden bereitgestellt, solange 200 OK im Vordergrund geöffnet ist. iOS stoppt den Server, wenn die App in den Hintergrund wechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serving works while 200 OK is open. iOS stops the server when the app moves to the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor funciona mientras 200 OK está en primer plano. iOS detiene el servidor cuando la aplicación pasa a segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont accessibles tant que 200 OK reste au premier plan. iOS arrête le serveur HTTP lorsque l’application passe en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server funziona mentre 200 OK è in primo piano. iOS arresta il server quando l’app passa in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK を画面に表示している間のみ、ファイルを配信できます。アプリがバックグラウンドに移ると、iOS が HTTP サーバーを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK가 화면에 열려 있는 동안에만 파일을 제공합니다. 앱이 백그라운드로 전환되면 iOS가 HTTP 서버를 중지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden aanbieden werkt zolang 200 OK op de voorgrond staat. iOS stopt de HTTP-server zodra de app naar de achtergrond gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie plików działa, gdy aplikacja 200 OK jest otwarta na pierwszym planie. iOS zatrzymuje serwer HTTP po przejściu aplikacji do tła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos ficam disponíveis enquanto o 200 OK está aberto em primeiro plano. O iOS para o servidor HTTP quando o app passa para segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele sunt furnizate cât timp aplicația 200 OK este deschisă în prim-plan. iOS oprește serverul când aplicația trece în fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы доступны, пока 200 OK открыто на экране. iOS останавливает HTTP-сервер при переходе приложения в фоновый режим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan tillhandahållas medan 200 OK är öppen. iOS stoppar HTTP-servern när appen går till bakgrunden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar yalnızca 200 OK ön planda açıkken sunulur. Uygulama arka plana geçtiğinde iOS, HTTP sunucusunu durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до файлів надається, поки 200 OK відкрито на екрані. iOS зупиняє HTTP-сервер, коли застосунок переходить у фоновий режим."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK 仅在前台运行时提供文件访问。应用进入后台时，iOS 会停止 HTTP 服务器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "200 OK 僅在前景開啟時提供檔案。App 進入背景時，iOS 會停止 HTTP 伺服器。"
          }
        }
      }
    },

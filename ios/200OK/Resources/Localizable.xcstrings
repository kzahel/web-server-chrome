{
  "sourceLanguage": "en",
  "strings": {
    "Allow cross-origin browser requests.": {
      "comment": "200 OK product copy: ServerScreen.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit požadavky prohlížeče z jiných zdrojů (CORS)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad browseranmodninger på tværs af oprindelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Browseranfragen von anderen Ursprüngen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow cross-origin browser requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir solicitudes del navegador desde otros orígenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les requêtes du navigateur provenant d’autres origines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentire le richieste del browser da origini diverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザからのクロスオリジンリクエストを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저의 교차 출처 요청을 허용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cross-originverzoeken van browsers toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwala na żądania z innych źródeł wysyłane przez przeglądarkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir solicitações de outras origens feitas pelo navegador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite cereri din browser de la alte origini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить запросы браузера из других источников."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt webbläsarförfrågningar från andra ursprung."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çapraz kaynaklı tarayıcı isteklerine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяти браузерні запити з інших джерел."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许浏览器发送跨源请求。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許瀏覽器傳送跨來源請求。"
          }
        }
      }
    },
    "Allow other devices on this Wi-Fi network to connect.": {
      "comment": "200 OK product copy: ServerScreen.swift",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit připojení dalším zařízením v této síti Wi-Fi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad andre enheder på dette Wi-Fi-netværk at oprette forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube anderen Geräten in diesem WLAN, sich zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow other devices on this Wi-Fi network to connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que otros dispositivos de esta red Wi-Fi se conecten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les autres appareils de ce réseau Wi-Fi à se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentire agli altri dispositivi su questa rete Wi-Fi di connettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Wi-Fi ネットワーク上の他のデバイスからの接続を許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Wi-Fi 네트워크의 다른 기기가 접속하도록 허용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta verbindingen van andere apparaten op dit Wi-Fi-netwerk toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwala innym urządzeniom w tej sieci Wi-Fi na łączenie się z serwerem HTTP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que outros dispositivos nesta rede Wi-Fi se conectem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite conectarea altor dispozitive din această rețea Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить подключение другим устройствам в этой сети Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt andra enheter i detta Wi-Fi-nätverk att ansluta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Wi-Fi ağındaki diğer cihazların bağlanmasına izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяти підключення інших пристроїв у цій мережі Wi-Fi."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许同一 Wi-Fi 网络中的其他设备连接。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許此 Wi-Fi 網路上的其他裝置連線。"
          }
        }
      }
    },

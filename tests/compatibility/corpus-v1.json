{
  "schemaVersion": 1,
  "corpusVersion": "1.0.0",
  "nativeHost": {
    "oldestPublic": "desktop-v0.1.4",
    "current": "desktop-v0.1.5",
    "cases": [
      {
        "id": "native-old-ping-current-host",
        "direction": "old-producer-new-consumer",
        "request": { "action": "ping" },
        "expected": { "action": "pong" }
      },
      {
        "id": "native-current-handshake-extra-field",
        "direction": "new-producer-old-consumer",
        "request": { "action": "handshake", "capabilities": ["launch"] },
        "expected": { "action": "handshake", "name": "ok200-host" }
      },
      {
        "id": "native-launch-extra-field",
        "direction": "new-producer-old-consumer",
        "request": { "action": "launch", "requestVersion": 2 },
        "launcherResult": "ok",
        "expected": { "action": "launch", "ok": true }
      },
      {
        "id": "native-future-action-old-host",
        "direction": "new-producer-old-consumer",
        "request": { "action": "status", "requestVersion": 2 },
        "expectedErrorContains": "unknown action: status"
      }
    ],
    "recovery": [
      {
        "id": "native-missing-host",
        "state": "not-installed",
        "primaryAction": "Get the Desktop App",
        "primaryUrl": "https://ok200.app/download"
      }
    ]
  },
  "crostiniController": {
    "oldestPublic": "crostini-v0.1.1",
    "current": "crostini-v0.1.5",
    "cases": [
      {
        "id": "controller-protocol-2-current",
        "direction": "current-current",
        "health": {
          "claimed": false,
          "instanceId": "fixture-1",
          "product": "ok200-crostini-controller",
          "protocolVersion": 2,
          "version": "0.1.5"
        },
        "accept": true
      },
      {
        "id": "controller-protocol-2-unknown-field",
        "direction": "new-producer-old-consumer",
        "health": {
          "claimed": false,
          "instanceId": "fixture-1",
          "product": "ok200-crostini-controller",
          "protocolVersion": 2,
          "version": "0.1.6",
          "capabilities": ["folder-picker"]
        },
        "accept": true
      },
      {
        "id": "controller-protocol-1-historical-gap",
        "direction": "old-producer-new-consumer",
        "health": {
          "claimed": false,
          "instanceId": "fixture-1",
          "product": "ok200-crostini-controller",
          "protocolVersion": 1,
          "version": "0.1.0"
        },
        "accept": false,
        "errorContains": "protocol 2"
      },
      {
        "id": "controller-protocol-3-future",
        "direction": "new-producer-old-consumer",
        "health": {
          "claimed": false,
          "instanceId": "fixture-1",
          "product": "ok200-crostini-controller",
          "protocolVersion": 3,
          "version": "0.2.0"
        },
        "accept": false,
        "errorContains": "protocol 2"
      },
      {
        "id": "controller-wrong-instance",
        "direction": "current-current",
        "health": {
          "claimed": true,
          "instanceId": "other-controller",
          "product": "ok200-crostini-controller",
          "protocolVersion": 2,
          "version": "0.1.5"
        },
        "accept": false,
        "errorContains": "different 200 OK controller"
      }
    ]
  },
  "crostiniRelease": {
    "cases": [
      { "id": "manifest-current", "kind": "manifest", "accept": true },
      {
        "id": "manifest-previous",
        "kind": "manifest",
        "replace": [
          ["version=0.1.0", "version=0.0.9"],
          ["tag=crostini-v0.1.0", "tag=crostini-v0.0.9"]
        ],
        "accept": true
      },
      {
        "id": "manifest-protocol-1",
        "kind": "manifest",
        "replace": [
          ["extension_protocol_min=2", "extension_protocol_min=1"],
          ["extension_protocol_max=2", "extension_protocol_max=1"]
        ],
        "accept": false,
        "errorContains": "incompatible"
      },
      {
        "id": "manifest-protocol-3",
        "kind": "manifest",
        "replace": [
          ["extension_protocol_min=2", "extension_protocol_min=3"],
          ["extension_protocol_max=2", "extension_protocol_max=3"]
        ],
        "accept": false,
        "errorContains": "incompatible"
      },
      {
        "id": "manifest-unknown-field",
        "kind": "manifest",
        "append": "future_capability=true\n",
        "accept": false,
        "errorContains": "unsupported shape"
      },
      {
        "id": "manifest-x86-64",
        "kind": "architecture",
        "architecture": "x86_64",
        "accept": true
      },
      {
        "id": "manifest-aarch64",
        "kind": "architecture",
        "architecture": "aarch64",
        "accept": true
      },
      {
        "id": "manifest-unknown-architecture",
        "kind": "architecture",
        "architecture": "riscv64",
        "accept": false,
        "errorContains": "unsupported architecture"
      },
      {
        "id": "installer-repair-current",
        "kind": "install-version",
        "current": "1.2.3",
        "candidate": "1.2.3",
        "accept": true
      },
      {
        "id": "installer-upgrade",
        "kind": "install-version",
        "current": "1.2.3",
        "candidate": "1.3.0",
        "accept": true
      },
      {
        "id": "installer-rollback-rejected",
        "kind": "install-version",
        "current": "1.2.3",
        "candidate": "1.2.2",
        "accept": false,
        "errorContains": "use rollback"
      }
    ]
  },
  "desktopUpdater": {
    "cases": [
      { "id": "updater-current", "mutation": "none", "accept": true },
      {
        "id": "updater-previous-public",
        "mutation": "previous-version",
        "accept": false,
        "errorContains": "does not match"
      },
      {
        "id": "updater-future-no-downgrade",
        "mutation": "future-version",
        "accept": false,
        "errorContains": "does not match"
      },
      {
        "id": "updater-malformed",
        "mutation": "missing-platforms",
        "accept": false,
        "errorContains": "platforms are missing"
      },
      {
        "id": "updater-wrong-package",
        "mutation": "linux-deb",
        "accept": false,
        "errorContains": "recommended primary package"
      }
    ]
  },
  "persistedSettings": {
    "ios": [
      {
        "id": "ios-settings-oldest",
        "form": "oldest",

---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const playStoreUrl =
  "https://play.google.com/store/apps/details?id=app.ok200.android";
const chromeOsUrl = "https://ok200.app/chromeos";
const androidIntentUrl =
  "intent://launch#Intent;scheme=ok200;package=app.ok200.android;" +
  `S.browser_fallback_url=${encodeURIComponent(chromeOsUrl)};end`;
---

<BaseLayout
  title="200 OK Web Server on ChromeOS"
  description="Choose the 200 OK Android app or the extension-controlled ChromeOS Linux server on supported Chromebooks and compatible ChromeOS Flex devices."
>
  <Header />

  <main class="chromeos-page">
    <section class="chromeos-hero">
      <div class="container narrow">
        <p class="eyebrow">ChromeOS</p>
        <h1>200 OK Web Server on your Chromebook</h1>
        <p class="lede">
          Choose the implementation you prefer. ChromeOS Linux works without
          Google Play and gives the extension full server controls; Android is
          the quickest setup when Play is available.
        </p>
      </div>
    </section>

    <section class="chromeos-options">
      <div class="container narrow cards">
        <article class="option-card">
          <p class="option-label">Full extension control</p>
          <h2>Use ChromeOS Linux</h2>
          <p>
            Install a small signed Linux component, then configure, start,
            stop, and update it from the extension—without Google Play. It is
            available for x86_64 and ARM64 Chromebooks and compatible x86_64
            ChromeOS Flex devices where the Linux development environment is
            available.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="/chromeos/linux">Linux setup guide</a>
          </div>
          <p class="note">
            Initial installation needs Internet access and one Terminal
            command. Afterward, open 200 OK Linux from the Launcher; normal
            launching and control work locally.
          </p>
        </article>

        <article class="option-card">
          <p class="option-label">Quickest setup</p>
          <h2>Use the Android app</h2>
          <p>
            Use Google Play when your Chromebook and account support Android
            apps. Some older, managed, work, or school Chromebooks do not
            provide this route. ChromeOS Flex does not support general Android
            apps.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={androidIntentUrl} target="_blank" rel="noopener">Open Android app</a>
            <a class="btn btn-secondary" href={playStoreUrl}>View on Google Play</a>
          </div>
          <p class="note">
            ChromeOS may ask you to confirm which app should open. If 200 OK is
            not offered and Google Play is unavailable in ChromeOS Settings,
            use the Linux option or another supported device.
          </p>
        </article>

        <article class="option-card">
          <p class="option-label">Other devices</p>
          <h2>Use another supported device</h2>
          <p>
            Run 200 OK on a macOS, Windows, or Linux computer, or on another
            Android device, and open the displayed network URL from your
            Chromebook.
          </p>
          <div class="actions">
            <a class="btn btn-secondary" href="/download">Desktop downloads</a>
            <a class="text-link" href="/#platforms">All supported platforms</a>
          </div>
        </article>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .chromeos-page {
    min-height: 70vh;
  }

  .narrow {
    max-width: 820px;
  }

  .chromeos-hero {
    padding: 72px 0 40px;
    text-align: center;
  }

  .eyebrow,
  .option-label {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0 16px;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.08;
  }

  .lede {
    margin: 0 auto;
    max-width: 650px;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .chromeos-options {
    padding: 0 0 80px;
  }

  .cards {
    display: grid;
    gap: 20px;
  }

  .option-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-secondary);
  }

  .option-card h2 {
    margin: 5px 0 10px;
  }

  .option-card p {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .note {
    margin: 18px 0 0;
    font-size: 0.9rem;
  }

  .text-link {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .chromeos-hero {
      padding-top: 48px;
    }

    .option-card {
      padding: 22px;
    }

    .actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>

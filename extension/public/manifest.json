{
  "manifest_version": 3,
  "name": "200 OK Web Server",
  "short_name": "200 OK",
  "version": "0.1.4",
  "description": "Launch 200 OK Web Server on desktop or ChromeOS. The successor to Web Server for Chrome.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/app.html",
    "default_title": "Open 200 OK Web Server"
  },
  "icons": {
    "16": "icons/ok-16.png",
    "32": "icons/ok-32.png",
    "48": "icons/ok-48.png",
    "128": "icons/ok-128.png"
  },
  "externally_connectable": {
    "ids": [
      "ofhbbkphhbklhfoeikjpcbhemlocgigb"
    ],
    "matches": [
      "https://ok200.app/*",
      "http://local.ok200.app/*"
    ]
  }
}

        "expected": {
          "port": 8080,
          "lanEnabled": true,
          "directoryListing": true,
          "corsEnabled": false,
          "spaEnabled": false,
          "lifetimeMode": "background",
          "wakeLockMode": "none",
          "shutdownBatteryThreshold": 50
